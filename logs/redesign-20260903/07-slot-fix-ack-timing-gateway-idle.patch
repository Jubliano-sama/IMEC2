+static uint32_t ack_retry_backoff_base_ms(uint8_t failure_count)
+{
+    uint32_t base_ms = MESH_RELAY_ACK_RETRY_BACKOFF_BASE_MS;
+    uint8_t doublings = failure_count > 1u ? (uint8_t)(failure_count - 1u) : 0u;
