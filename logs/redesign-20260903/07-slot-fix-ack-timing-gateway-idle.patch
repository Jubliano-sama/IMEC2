+    while (doublings > 0u && base_ms < MESH_RELAY_ACK_RETRY_BACKOFF_CAP_MS) {
+        if (base_ms > MESH_RELAY_ACK_RETRY_BACKOFF_CAP_MS / 2u) {
+            base_ms = MESH_RELAY_ACK_RETRY_BACKOFF_CAP_MS;
+        } else {
+            base_ms *= 2u;
+        }
+        doublings--;
+    }
+    return base_ms;
+}
