     return clicker_discover_uwb_anchors_until(session, deadline_ms);
 }
 
+static void clicker_sort_schedule_entries_by_depth_and_slot(
+    const struct uwb_clicker_session *session,
+    struct uwb_range_schedule_frame *schedule)
+{
+    if (session == NULL || schedule == NULL || schedule->selected_count <= 1u) {
+        return;
+    }
+
+    for (uint8_t i = 0u; i < schedule->selected_count; i++) {
+        for (uint8_t j = (uint8_t)(i + 1u); j < schedule->selected_count; j++) {
+            uint8_t depth_i = 1u, slot_i = 0u;
+            uint8_t depth_j = 1u, slot_j = 0u;
+
+            for (uint8_t c = 0u; c < session->candidate_count; c++) {
+                if (session->candidates[c].anchor_id == schedule->entries[i].anchor_id) {
+                    depth_i = session->candidates[c].hop_depth > 0u ? session->candidates[c].hop_depth : 1u;
+                    slot_i = session->candidates[c].anchor_slot;
+                }
+                if (session->candidates[c].anchor_id == schedule->entries[j].anchor_id) {
+                    depth_j = session->candidates[c].hop_depth > 0u ? session->candidates[c].hop_depth : 1u;
+                    slot_j = session->candidates[c].anchor_slot;
+                }
+            }
+
+            if (depth_j < depth_i ||
+                (depth_j == depth_i && slot_j < slot_i) ||
+                (depth_j == depth_i && slot_j == slot_i &&
+                 schedule->entries[j].anchor_id < schedule->entries[i].anchor_id)) {
+                struct uwb_range_schedule_entry tmp = schedule->entries[i];
+                schedule->entries[i] = schedule->entries[j];
+                schedule->entries[j] = tmp;
+            }
+        }
+    }
+
+    for (uint8_t i = 0u; i < schedule->selected_count; i++) {
+        schedule->entries[i].seq = (uint8_t)(i + 1u);
+    }
+}
+
