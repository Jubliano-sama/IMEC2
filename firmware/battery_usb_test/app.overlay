#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		battery-adc-enable = &battery_adc_enable;
		battery-green-pwm = &pwm_led0;
		usb-blue = &usb_blue;
	};

	battery_control {
		compatible = "gpio-leds";

		battery_adc_enable: battery_adc_enable {
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
			label = "Battery ADC divider enable";
		};
	};

	usb_indicator {
		compatible = "gpio-leds";

		usb_blue: usb_blue {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "USB present blue LED";
		};
	};

	zephyr,user {
		io-channels = <&adc 5>;
	};
};

&pwm_led0 {
	pwms = <&pwm0 0 PWM_MSEC(2) PWM_POLARITY_NORMAL>;
	label = "Battery voltage green PWM";
};

&pwm0_default {
	group1 {
		psels = <NRF_PSEL(PWM_OUT0, 0, 14)>;
		/delete-property/ nordic,invert;
	};
};

&pwm0_sleep {
	group1 {
		psels = <NRF_PSEL(PWM_OUT0, 0, 14)>;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	battery_adc: channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;
		zephyr,resolution = <12>;
	};
};
