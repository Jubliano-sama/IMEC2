mainmenu "IMEC UWB firmware"

source "Kconfig.zephyr"

menu "IMEC power management"

config IMEC_CLICKER_SYSTEMOFF_IDLE
    bool "Put the clicker in system-off while idle"
    default y
    select POWEROFF
    help
      The clicker parks the DWM3000 and board GPIOs, arms the physical click
      button as a wake source, and enters nRF system-off whenever it is not
      actively handling a click or self-test interaction.

endmenu

menu "IMEC high-debug bring-up"

config IMEC_HIGH_DEBUG
    bool "Enable high-debug staged bring-up firmware"
    help
      Enables bench-oriented logging, counters, command parser, and stage
      behavior. Production role defaults are unchanged when this is disabled.

config IMEC_BENCH_STAGE
    int "High-debug bench stage"
    range 0 3
    default 0
    depends on IMEC_HIGH_DEBUG
    help
      Hardware bring-up stage: 0 is tag-only, 1 is one tag plus one anchor,
      2 is one tag plus multiple anchors, and 3 adds the gateway.

config IMEC_ROLE_TAG
    bool "Build as tag alias"
    depends on IMEC_HIGH_DEBUG
    help
      Bench alias for the existing clicker role.

config IMEC_ROLE_CLICKER
    bool "Build as clicker"
    depends on IMEC_HIGH_DEBUG
    help
      Existing clicker role. The tag alias maps to this same role.

config IMEC_ROLE_ANCHOR
    bool "Build as anchor"
    depends on IMEC_HIGH_DEBUG

config IMEC_ROLE_GATEWAY
    bool "Build as gateway"
    depends on IMEC_HIGH_DEBUG

config IMEC_USB_BOOTLOADER
    bool "Build for MCUboot USB-C serial recovery"
    depends on IMEC_HIGH_DEBUG
    help
      Build the application as an MCUboot child image and enable the app-side
      bootloader entry command when retention boot mode is available.

config IMEC_USB_CDC_LOGS
    bool "Use USB CDC for high-debug human logs"
    depends on IMEC_HIGH_DEBUG
    default y
    help
      Human-readable logs use the selected USB CDC console. Disable this when
      the USB CDC endpoint must be reserved for binary gateway COBS packets.

config IMEC_RTT_LOGS
    bool "Use RTT for high-debug human logs"
    depends on IMEC_HIGH_DEBUG
    help
      Route human-readable logs to RTT. Used by default for high-debug gateway
      builds so USB CDC can stay dedicated to binary gateway packets.

config IMEC_GATEWAY_BINARY_CDC
    bool "Reserve USB CDC for gateway binary COBS packets"
    depends on IMEC_HIGH_DEBUG
    help
      The gateway serial frame endpoint remains binary-only. Human-readable
      debug logs must use RTT or another endpoint.

config IMEC_STAGE0_SEND_WAKE_CLAIM_ON_CLICK
    bool "Send one WAKE_CLAIM train on Stage 0 short press"
    depends on IMEC_HIGH_DEBUG && IMEC_BENCH_STAGE = 0
    help
      Stage 0 normally stays tag-only. Enable this only when intentional RF
      wake-claim transmission is wanted without requiring an anchor.

config IMEC_STAGE1_ALLOW_SINGLE_ANCHOR_RANGE
    bool "Allow one-anchor Stage 1 bench ranging"
    depends on IMEC_HIGH_DEBUG && IMEC_BENCH_STAGE = 1
    help
      Bench-only diagnostic path that lets a Stage 1 clicker schedule and range
      one anchor. Production normal-click acceptance remains three unique
      RANGE_OK anchors.

config IMEC_STAGE1_TAG_CONTINUOUS_WAKE_CLAIMS
    bool "Continuously transmit Stage 1 tag wake claims"
    depends on IMEC_HIGH_DEBUG && IMEC_BENCH_STAGE = 1 && IMEC_ROLE_TAG
    help
      Bench-only diagnostic path that bypasses button/system-off behavior and
      repeatedly transmits normal Stage 1 WAKE_CLAIM trains from boot. This is
      intended for anchor RX bring-up with no manual button presses.

config IMEC_STAGE1_ANCHOR_CONTINUOUS_SCAN
    bool "Use high-duty Stage 1 anchor UWB wake scan"
    depends on IMEC_HIGH_DEBUG && IMEC_BENCH_STAGE = 1 && IMEC_ROLE_ANCHOR
    help
      Bench-only diagnostic path that keeps the Stage 1 anchor listening for
      wake claims with an 80 ms RX window in each 400 ms wake-train period. The
      scan uses one software-bounded open RX window with the hardware preamble
      timeout disabled, matching the known-working DS-TWR responder listen style.
      It retries immediately after partial/bad wake activity instead of applying
      the normal false-wake cooldown. Production and normal high-debug low-duty
      scan timing are unchanged when this is off.

config IMEC_STAGE1_ANCHOR_FOCUSED_RX_LOGS
    bool "Reduce repetitive Stage 1 anchor RX scan logs"
    depends on IMEC_STAGE1_ANCHOR_CONTINUOUS_SCAN
    default y
    help
      Bench-only log filter for high-duty anchor scans. It keeps claim,
      arbitration, decode, and periodic diagnostics visible while suppressing
      per-millisecond RX start, SFD-timeout, and sleep/wake chatter that can
      overflow RTT and hide the protocol events under test.

config IMEC_HIGH_DEBUG_COUNTER_PERIOD_MS
    int "High-debug counter dump period in milliseconds"
    depends on IMEC_HIGH_DEBUG
    default 30000
    range 1000 3600000

config IMEC_HIGH_DEBUG_COMMAND_POLL_MS
    int "High-debug CDC command poll period in milliseconds"
    depends on IMEC_HIGH_DEBUG
    default 20
    range 5 1000

endmenu
