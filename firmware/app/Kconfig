mainmenu "IMEC UWB firmware"

source "Kconfig.zephyr"

menu "IMEC power management"

config IMEC_CLICKER_SYSTEMOFF_IDLE
    bool "Put the clicker in system-off while idle"
    default n
    help
      Fallback mode for power profiling or recovery experiments. PoC default
      is disabled: the clicker stays in always-on kernel idle so UWB stays
      ready and no poweroff path is exercised.

config IMEC_CLICKER_SYSTEMOFF_RAM_RETENTION
    bool "Retain RAM while clicker is in system-off idle"
    default n
    depends on IMEC_CLICKER_SYSTEMOFF_IDLE
    help
      Before entering nRF system-off idle, request RAM section retention so a
      button wake can preserve retained RAM state. This is the fallback
      clicker power-profile behavior when retained System ON idle is disabled.

config IMEC_CLICKER_SYSTEMON_RETAINED_IDLE
    bool "Keep the clicker in retained system-on idle"
    default n
    help
      PoC default: disabled. The clicker stays booted with the
      DWM3000 idle (not retained sleep) and the kernel sleeps on
      the button GPIO interrupt. Re-enable for battery profiling
      after the bring-up path is stable.

endmenu

menu "IMEC ML data collection"

config IMEC_ML_CLICKER
    bool "Build the BLE-controlled ML range data clicker"
    depends on BT && IMEC_GATEWAY_BLE
    help
      Exposes the existing connected gateway BLE packet/log service from the
      clicker role and accepts a BLE command to run fresh UWB discovery plus
      production-like DS-TWR sample collection for range offset training.
      Normal clicker button and idle behavior are left disabled in this image.

config IMEC_ML_ANCHOR
    bool "Build the deterministic ML data collection anchor"
    help
      Uses the proven UWB discovery/ranging path with ML-specific deterministic
      discovery slots, full-duty idle receive scanning, and periodic Li-ion
      battery-status LED blinking. Normal anchor duty-cycle limits are unchanged
      unless this image is explicitly selected.

config IMEC_ML_DEFAULT_SAMPLES_PER_ANCHOR
    int "Default ML collection samples per anchor"
    depends on IMEC_ML_CLICKER
    default 8
    range 1 100
    help
      Default sample count requested per selected anchor. The production range
      schedule still caps the total exchanges that fit in one burst.

config IMEC_ML_MAX_ANCHORS
    int "Maximum anchors selected per ML collection"
    depends on IMEC_ML_CLICKER
    default 8
    range 1 8
    help
      Compatibility cap for ML collection. The ML command path selects up to
      the configured discovery slot count, and the UWB schedule supports up to
      eight anchors.

config IMEC_ML_DISCOVERY_SLOT_COUNT
    int "ML discovery reply slot count"
    depends on IMEC_ML_CLICKER
    default 8
    range 1 8
    help
      Slot count used by the ML clicker discovery frame. The ML command path
      can select as many anchors as this slot count, up to eight anchors.

endmenu

menu "IMEC connected-routing mesh"

config IMEC_DEDICATED_COMM_WORKQUEUE
    bool "Run communication and mesh work on a dedicated queue"
    default y if IMEC_MESH_ROUTE_TEST
    help
      Keeps route discovery, delivery retries, receive processing, and radio
      work off the main and system workqueue stacks. Production mesh presets
      enable this so protocol workers only admit immutable communication work.

config IMEC_MESH_ROUTE_TEST
    bool "Build the connected-routing mesh runtime"
    help
      Enables the production-successor connected-routing runtime used by the
      mesh clicker, anchor, and gateway presets. Bench transmitter presets add
      their synthetic traffic options separately. Legacy and ML roles remain
      untouched unless a mesh_* build preset selects this option.

config IMEC_MESH_ROUTE_TEST_TRANSMITTER
    bool "Continuously transmit synthetic mesh-test packets"
    depends on IMEC_MESH_ROUTE_TEST
    help
      Runs an anchor-role mesh node that continuously sends synthetic
      MSG_MESH_DATA packets toward the gateway through the normal relay path.

config MESH_SMOKE_FAST_TX
    bool "Run one-hop mesh smoke traffic as fast as safely allowed"
    depends on IMEC_MESH_ROUTE_TEST_TRANSMITTER
    help
      Queues synthetic gateway-bound packets immediately after the normal mesh
      state allows more traffic. This does not bypass channel-5 contact,
      channel-9 event negotiation, gateway ACK, custody, retry, preemption, or
      persistent delivery state.

config IMEC_MESH_ROUTE_TEST_RELAY_REQUIRED_ROUTE_REQ
    bool "Force gateway route requests through a relay"
    depends on IMEC_MESH_ROUTE_TEST
    help
      Prevents a direct gateway probe from satisfying route acquisition and
      marks gateway route requests so direct copies from the origin cannot
      complete the route. This is a bench-only mode for validating relay route
      handling while every board remains close enough to probe. Normal mesh
      role presets leave this disabled.

config IMEC_MESH_ROUTE_TEST_RELAY_REQUIRED_GATEWAY_CONTROL
    bool "Require relayed gateway control on the forced-hop anchor"
    depends on IMEC_MESH_ROUTE_TEST
    help
      Rejects gateway-originated control received directly from the gateway so
      the same command must arrive through another anchor. This is a bench-only
      companion to relay-required route acquisition and leaves normal mesh
      role presets unchanged.

config IMEC_MESH_ROUTE_TEST_TX_INTERVAL_MS
    int "Synthetic mesh-test packet interval in milliseconds"
    depends on IMEC_MESH_ROUTE_TEST_TRANSMITTER
    default 1000
    range 100 60000

config IMEC_MESH_ROUTE_TEST_TX_BURST_COUNT
    int "Synthetic mesh-test packets queued per interval"
    depends on IMEC_MESH_ROUTE_TEST_TRANSMITTER
    default 1
    range 1 8
    help
      Number of synthetic MSG_MESH_DATA packets submitted together through
      the node-communication service. Values above one exercise immutable
      custody, admission backpressure, priority reserve, retry, and terminal
      result handling under sustained load.

config IMEC_MESH_ROUTE_TEST_PAYLOAD_BYTES
    int "Synthetic mesh-test target payload size"
    depends on IMEC_MESH_ROUTE_TEST_TRANSMITTER
    default 0
    range 0 958
    help
      Target TLV payload length for synthetic MSG_MESH_DATA packets. Values
      above the metadata payload size are filled with TLV_MESH_TEST_PADDING
      bytes to force large channel-9 frames and sustained queue backlog.

config IMEC_MESH_ROUTE_TEST_CH5_SCAN_INTERVAL_MS
    int "Mesh-test channel-5 anchor scan idle interval in milliseconds"
    depends on IMEC_MESH_ROUTE_TEST
    default IMEC_ANCHOR_UWB_SCAN_INTERVAL_MS
    range 0 60000
    help
      Delay between channel-5 wake/contact scans for mesh-test anchors. A
      value of zero makes the anchor immediately reschedule the next scan.
      The default tracks the normal anchor low-duty wake-scan cadence.

config IMEC_MESH_ROUTE_TEST_CH5_SCAN_RX_US
    int "Mesh-test channel-5 anchor scan receive window in microseconds"
    depends on IMEC_MESH_ROUTE_TEST
    default IMEC_ANCHOR_UWB_SCAN_RX_US
    range 1000 1000000
    help
      Active UWB receive time for each mesh-test channel-5 scan slice. The
      default tracks the normal anchor low-duty wake-scan receive slice.

config IMEC_MESH_ROUTE_TEST_STARTUP_GRACE_MS
    int "Mesh-test startup delay before UWB activity"
    depends on IMEC_MESH_ROUTE_TEST
    default 0
    range 0 60000
    help
      Delay mesh-test UWB scan and synthetic TX startup long enough for BLE
      debug advertising to become visible before UWB routing traffic starts.

endmenu

menu "IMEC bench diagnostics"

config IMEC_STACK_DIAGNOSTICS
    bool "Emit typed RTT stack workload samples"
    depends on THREAD_MONITOR && THREAD_STACK_INFO && INIT_STACKS && USE_SEGGER_RTT
    help
      Emits correlated run, sample, queue, and custody records for real
      production operations. Deployable mesh presets enable this so their exact
      ELF can be tied to a hardware capture. Interrupt-stack output is explicit
      configuration evidence only; Zephyr has no supported ISR high-water mark.

config IMEC_STACK_STRESS_DIAGNOSTICS
    bool "Enable embedded stack stress diagnostics"
    depends on IMEC_STACK_DIAGNOSTICS && STACK_CANARIES
    depends on HW_STACK_PROTECTION
    help
      Adds compiler stack canaries and retained fatal thread/stack context.
      Existing typed workload samples already record each thread's stack
      watermark without a periodic analyzer thread or nested logger output.
      This option does not change any configured stack size. CMake exposes it
      only through IMEC_STACK_STRESS_BUILD on the exact mesh_clicker,
      mesh_anchor, and mesh_gateway presets.

config IMEC_DS_TWR_RTT_DEBUG
    bool "Emit compact DS-TWR stage diagnostics over RTT"
    help
      Emits one compact record at each POLL, RESPONSE, FINAL, and REPORT stage.
      This is intended for timing-sensitive bench captures where subsystem
      debug logging would overflow RTT and obscure the exchange itself.

endmenu


config IMEC_ANCHOR_UWB_SCAN_INTERVAL_MS
    int "Anchor low-duty UWB wake scan interval in milliseconds"
    default 380
    range 1 60000
    help
      Interval between low-duty anchor wake-scan attempts.

config IMEC_ANCHOR_UWB_SCAN_RX_US
    int "Anchor low-duty UWB wake scan receive slice in microseconds"
    default 3000
    range 1 1000000
    help
      Active UWB receive time inside each low-duty anchor wake-scan attempt.

config IMEC_GATEWAY_BLE
    bool "Use connected Bluetooth for gateway PC communication"
    depends on BT
    help
      The gateway exposes a connectable BLE GATT service to the PC. One
      characteristic accepts COBS-delimited binary gateway packets, one
      notifies COBS-delimited gateway packets back to the PC. This replaces the
      old app-side serial gateway transport. Firmware logs remain available
      through RTT and are not carried over BLE.
