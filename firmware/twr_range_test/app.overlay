#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	aliases {
		dwm3000 = &dwm3000;
		dwm3000-reset = &dwm3000_reset;
		dwm3000-wakeup = &dwm3000_wakeup;
		status0-red = &status0_red;
		status0-green = &status0_green;
		status0-blue = &status0_blue;
	};

	status_leds {
		compatible = "gpio-leds";

		status0_red: status0_red {
			gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
			label = "Status LED 0 red";
		};

		status0_green: status0_green {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			label = "Status LED 0 green";
		};

		status0_blue: status0_blue {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "Status LED 0 blue";
		};
	};

	dwm3000_control {
		compatible = "gpio-leds";

		dwm3000_reset: dwm3000_reset {
			gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
			label = "DWM3000 reset";
		};

		dwm3000_wakeup: dwm3000_wakeup {
			gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
			label = "DWM3000 wakeup";
		};
	};
};

&pinctrl {
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 11)>,
				<NRF_PSEL(SPIM_MISO, 0, 12)>,
				<NRF_PSEL(SPIM_MOSI, 1, 0)>;
		};
	};

	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 11)>,
				<NRF_PSEL(SPIM_MISO, 0, 12)>,
				<NRF_PSEL(SPIM_MOSI, 1, 0)>;
			low-power-enable;
		};
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;

	dwm3000: dwm3000@0 {
		compatible = "qorvo,dwm3000";
		reg = <0>;
		spi-max-frequency = <32000000>;
		slow-spi-frequency = <2000000>;
		fast-spi-frequency = <32000000>;
		reset-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
		wakeup-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
	};
};
